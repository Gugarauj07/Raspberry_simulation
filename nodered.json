    {
        "id": "74fc4b09077b254d",
        "type": "function",
        "z": "e21ac7cdba945ac9",
        "name": "Processar Status do Ar Condicionado",
        "func": "// Verifica o status do ar condicionado baseado no payload\nvar status = msg.payload.status;  // Acessa o status do payload JSON\n\n// Verifica o valor de status e define a mensagem a ser exibida\nif (status === \"ligado\") {\n    msg.payload = \"Ar Condicionado Ligado\";  // Se status for 'ligado'\n} else if (status === \"desligado\") {\n    msg.payload = \"Ar Condicionado Desligado\";  // Se status for 'desligado'\n} else {\n    msg.payload = \"Status Desconhecido\";  // Se status for outro valor\n}\n\n// Retorna a mensagem para o próximo nó\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 120,
        "wires": [
